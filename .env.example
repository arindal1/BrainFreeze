# PostgreSQL (Neon) connection string
DATABASE_URL=postgres://user:password@host:5432/brainfreeze

# NextAuth
AUTH_SECRET=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Worker
WORKER_CONCURRENCY=2

# LLM provider keys - add as many rotating keys as you have
GEMINI_KEY_1=
GEMINI_KEY_2=
# Nemotron (nvidia/nemotron-3-ultra-550b-a55b:free) via OpenRouter
OPENROUTER_KEY_1=
OPENROUTER_KEY_2=
# Groq Cloud (llama-3.3-70b-versatile) - agent-c base model
GROQ_KEY_1=
GROQ_KEY_2=
# Tavily web search - grounds agent-c
TAVILY_KEY_1=
TAVILY_KEY_2=
# Firecrawl page scrape - no key needed, but add for higher rate limits
FIRECRAWL_KEY=

# Web Push (VAPID) - generate with `npx web-push generate-vapid-keys`
# Public key is exposed to the browser (NEXT_PUBLIC_*) by design - it is not secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com